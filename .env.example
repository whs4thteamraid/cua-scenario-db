# 복사해서 .env 로 쓸 것.  --smoke 는 키 없이 동작한다.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
KIMI_API_KEY=

# 웹 UI 를 터널로 외부에 노출할 때 필수
WEBUI_PASSWORD=

# 하네스 경로. 레포 안 OSWorld/ 를 쓰면 비워둬도 된다.
OSWORLD_ROOT=
RAID_VMX=vmware_vm_data/Ubuntu0/Ubuntu0.vmx

# VM 을 호스트에 띄우지 않는다(기본). 디버깅하려면 0.
RAID_HEADLESS=1

# 결과 분석에 쓸 모델 (텍스트만 — 저렴하다). 기본 claude-sonnet-5.
#   공급자를 고정하려면 ANALYZE_PROVIDER=anthropic|openai|kimi
ANALYZE_MODEL=
ANALYZE_PROVIDER=
