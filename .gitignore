# 비밀 — 절대 커밋하지 않는다
.env
.env.*
!.env.example
*.key

# 실행 산출물 (레포에 넣지 않는다 — 결과는 웹 UI 가 그때그때 읽는다)
webui/_logs/
_results/
results/
report.html

# 시나리오 실행이 남기는 상태·로그·메모리 (사람마다 다르고 호스트 경로가 박힌다)
.run.info
.run.lock
exfil_capture.jsonl
guest_requests.jsonl
OSWorld/redteam/memstore_*/
# 시나리오 자체 실행기가 직접 쓰는 증거 폴더 (스크린샷·원장 — 레포에 넣지 않는다)
security_results/
_bak/

# 하네스가 받아오는 VM 이미지 (수 GB)
vmware_vm_data/
.vmware_vms
*.vmx
*.vmdk

__pycache__/
*.py[cod]
.venv/
.DS_Store

# 하네스 가상환경 — uv sync 로 각자 만든다
OSWorld/.venv/
OSWorld/**/__pycache__/

# 업스트림 OSWorld 가 들고 있는 상용 프록시 설정 자리 (빈 껍데기 — 올리지 않는다)
OSWorld/evaluation_examples/settings/proxy/
# 하네스 실행 캐시 (시나리오 이름이 폴더로 남는다)
OSWorld/cache/

# 시나리오 서버·자가점검이 남기는 실행 기록 (돌릴 때마다 생긴다 — 레포에 넣지 않는다)
OSWorld/security_scenarios/*/hits.jsonl
OSWorld/security_scenarios/*/.selftest_events.jsonl

# ── 안전망: 앞으로 생길 수 있는 것들 ─────────────────────────────────────────
# 비밀·개인 설정
.envrc
*.pem
*.p12
id_rsa*
# 실행 결과가 어디에 떨어지든 (시나리오 폴더 밖·이름이 바뀐 결과 폴더 포함)
_results*/
batch_results/
trajectory.jsonl
step_*.png
trial_summary.json
runs.csv
aggregate.json
events.jsonl
*.log
# 지울 권한이 없을 때 옮겨 두는 자리
_to_delete/
# 가상환경·도구 캐시 (README 의 .venv.uvpy 포함)
.venv*/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
# 편집기·OS
.vscode/
.idea/
._*
Thumbs.db
